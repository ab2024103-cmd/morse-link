    <string name="pref_about">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">MorseLink is a local, offline, peer-to-peer file transfer app. No internet, no accounts, no ads, no tracking. Transfers move directly between paired devices over Wi-Fi, Bluetooth, or your own hotspot.</string>

