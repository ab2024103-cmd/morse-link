    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Share files, offline</string>
    <string name="onboarding_welcome_body">MorseLink sends photos, videos, music, apps, and any file directly between two devices — no internet, no cloud, no accounts, no ads. Nothing ever leaves your devices except the files you choose to send.</string>
    <string name="onboarding_permissions_title">About permissions</string>
    <string name="onboarding_permissions_body">MorseLink will ask for a few permissions:\n\n• Nearby devices / Bluetooth: only to find phones to share with.\n• Location (on older Androids): the system requires it for Wi-Fi scanning. MorseLink never records or sends your location.\n• Photos, videos, and music: only to list them for sending.\n\nEach request is explained again the first time it is needed.</string>
    <string name="onboarding_name_title">Your device name</string>
    <string name="onboarding_name_body">This is the name other devices see when you pair. You can change it later in Settings.</string>
    <string name="onboarding_modes_title">Two ways to share</string>
    <string name="onboarding_modes_body">Phone to phone: both devices search and pair, then transfer over Wi-Fi.\n\nPhone to PC: your phone shows a QR code — open it in any browser on the computer and drag files in both directions.</string>
    <string name="onboarding_crash_title">Crash reports stay local</string>
    <string name="onboarding_crash_body">If MorseLink crashes, a technical crash log is saved on this device only. It is never sent anywhere automatically — you can view and share it yourself from Settings. You can turn this off entirely.</string>
    <string name="onboarding_crash_toggle">Save crash logs on this device</string>
    <string name="onboarding_fgs_note">During transfers, MorseLink keeps a notification so the transfer survives when you switch apps. It disappears when the transfer ends.</string>

